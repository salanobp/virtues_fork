# Branch B: Varlen Path (FlashAttention oder SDPA Fallback)
        if return_attention:
            raise ValueError("return_attention=True is not supported with varlen path.")

        if cu_seq_len is None or max_seq_len is None:
            raise ValueError("Varlen path requires both cu_seq_len and max_seq_len.")

        # Heads in (B, N, H, D)
        Q = Q.view(B, L, self.num_heads, self.head_dim)
        K = K.view(B, S, self.num_heads, self.head_dim)
        V = V.view(B, S, self.num_heads, self.head_dim)

        # Optional positional embedding AFTER linear projections (per head)
        if self.pos_after_linear:
            Q, K = self._apply_pos_after_linear_heads(Q, K, query_pos, key_pos, heads_expansion="BNH")

        # --- NEU: Hardware Check & Fallback ---
        if is_flash_attn_supported():
            # Originaler FlashAttention Pfad
            if torch.is_autocast_enabled():
                dtype = torch.get_autocast_gpu_dtype()
                Q, K, V = Q.to(dtype), K.to(dtype), V.to(dtype)

            # Korrektes Packing für varlen (B muss hier 1 sein für squeeze(0))
            qkv = torch.stack([Q.squeeze(0), K.squeeze(0), V.squeeze(0)], dim=1)
            
            attn_out = flash_attn_varlen_qkvpacked_func(
                qkv=qkv,
                cu_seqlens=cu_seq_len,
                max_seqlen=max_seq_len,
                deterministic=True,
                dropout_p=self.dropout if self.training else 0.0,
            ).unsqueeze(0)  # (1, total_L, H, D)
        else:
            # SDPA Fallback für ältere GPUs (Turing/Pascal etc.)
            # Wir müssen aus cu_seq_len eine Block-Diagonal-Maske erstellen
            total_L = Q.shape[1]
            device = Q.device
            dtype = Q.dtype
            
            # Maske erstellen: (1, 1, total_L, total_L)
            # Verhindert, dass Tokens über Sequenzgrenzen hinweg Aufmerksamkeit schenken
            attn_mask = torch.full((total_L, total_L), float("-inf"), device=device, dtype=dtype)
            
            # cu_seq_len ist [0, len1, len1+len2, ...]
            for i in range(len(cu_seq_len) - 1):
                start, end = cu_seq_len[i], cu_seq_len[i+1]
                attn_mask[start:end, start:end] = 0.0
            
            # SDPA erwartet (B, H, L, D)
            Q_sdpa = Q.transpose(1, 2) # (B, H, L, D)
            K_sdpa = K.transpose(1, 2)
            V_sdpa = V.transpose(1, 2)
            
            attn_out = F.scaled_dot_product_attention(
                Q_sdpa, K_sdpa, V_sdpa,
                attn_mask=attn_mask.unsqueeze(0).unsqueeze(0),
                dropout_p=self.dropout if self.training else 0.0,
            ).transpose(1, 2) # Zurück zu (B, L, H, D)

        # Merge heads & Final Projection
        out = attn_out.reshape(B, L, self.embed_dim)
        return self.W_o(out)